# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio で発行した Gemini の API キー（サーバー側だけで使う）
GEMINI_API_KEY=
# 省略時は gemini-3.5-flash-lite（速さ重視）。品質重視なら gemini-3.8-flash
GEMINI_MODEL=

# 自分のメールアドレス。これ以外のアカウントでは変換できない
ALLOWED_EMAIL=
