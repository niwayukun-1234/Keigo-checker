# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio で発行した Gemini の API キー（サーバー側だけで使う）
GEMINI_API_KEY=
# 使い分けるモデル（省略可）。ふだんは速い FAST、丁寧度4以上・取引先・メール・謝罪は QUALITY
GEMINI_MODEL_FAST=
GEMINI_MODEL_QUALITY=

# 自分のメールアドレス。これ以外のアカウントでは変換できない
ALLOWED_EMAIL=
